# Copy this file to .env (never commit .env) and fill in your own values.
# The cloud pipelines read the same names from GitHub secrets (see docs/SECRETS.md).

# Google AI Studio keys (aistudio.google.com > Get API key). Free tier.
GEMINI_API_KEY=            # the daily Shorts (writing, picture descriptions)
GEMINI_API_KEY_STORIES=    # the long stories (writing, acted voices, picture checks): a second project's key

# Hugging Face read token (huggingface.co/settings/tokens): the Mahaperiyava voice model (IndicF5)
HF_TOKEN=

# Optional: only if you switch the writer to Claude
ANTHROPIC_API_KEY=
